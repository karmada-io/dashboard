{
  "name": "karmada-dashboard-ui",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dashboard:dev": "turbo dev --filter @karmada/dashboard",
    "dashboard:build": "turbo build --filter @karmada/dashboard",
    "demos:dev": "turbo dev --filter @karmada/demos",
    "prepare": "cd .. && husky install ui/.husky",
    "dashboard": "pnpm --filter @karmada/dashboard",
    "chatui": "pnpm --filter @karmada/chatui",
    "terminal": "pnpm --filter @karmada/terminal",
    "translators": "pnpm --filter @karmada/translators"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.4",
    "turbo": "^2.10.5",
    "unrun": "^0.3.1"
  },
  "dependencies": {
    "dayjs": "^1.11.21"
  },
  "packageManager": "pnpm@9.1.2",
  "pnpm": {
    "overrides": {
      "react": "^19.2.7",
      "react-dom": "^19.2.7"
    },
    "patchedDependencies": {
      "zmodem.js@0.1.10": "patches/zmodem.js@0.1.10.patch"
    }
  }
}
